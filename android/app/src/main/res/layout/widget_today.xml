<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_today_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12131A"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Daily Spark logo"
            android:src="@drawable/ic_launcher_brand" />

        <TextView
            android:id="@+id/widget_today_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Daily Spark"
            android:textColor="#F3F4F6"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_today_streak_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 0"
            android:textColor="#F29559"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_today_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Pending Habits"
        android:textColor="#9CA3AF"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/widget_today_items_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_today_item_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="#1E202B"
            android:padding="6dp"
            android:text="✨ Check in to Daily Spark"
            android:textColor="#E5E7EB"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_today_item_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="#1E202B"
            android:padding="6dp"
            android:text=""
            android:textColor="#E5E7EB"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_today_item_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E202B"
            android:padding="6dp"
            android:text=""
            android:textColor="#E5E7EB"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>

