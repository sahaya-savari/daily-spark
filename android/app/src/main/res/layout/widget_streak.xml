<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_streak_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12131A"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="Daily Spark logo"
        android:src="@drawable/ic_launcher_brand" />

    <TextView
        android:id="@+id/widget_streak_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔥"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/widget_streak_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="0"
        android:textColor="#F3F4F6"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_streak_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DAY STREAK"
        android:textColor="#9CA3AF"
        android:textSize="8sp"
        android:letterSpacing="0.08" />

</LinearLayout>

