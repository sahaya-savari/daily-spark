{
  "id": "/daily-spark/",
  "name": "Daily Spark",
  "short_name": "Daily Spark",
  "description": "A focused, offline-first daily streak tracker. Create it, tick it, keep going.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/daily-spark/",
  "scope": "/daily-spark/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait",
  "background_color": "#17171D",
  "theme_color": "#17171D",
  "categories": ["productivity", "utilities"],
  "shortcuts": [
    {
      "name": "Add Habit",
      "short_name": "Add",
      "description": "Quickly create a new habit",
      "url": "/daily-spark/?action=add",
      "icons": [{ "src": "/daily-spark/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Today's Habits",
      "short_name": "Today",
      "description": "View habits due today",
      "url": "/daily-spark/?tab=today",
      "icons": [{ "src": "/daily-spark/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "icons": [
    { "src": "/daily-spark/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/daily-spark/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/daily-spark/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
