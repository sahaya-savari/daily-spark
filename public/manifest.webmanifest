{
  "id": "/",
  "name": "Daily Spark",
  "short_name": "Daily Spark",
  "description": "A focused, offline-first daily streak tracker. Create it, tick it, keep going.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait",
  "background_color": "#17171D",
  "theme_color": "#17171D",
  "categories": ["productivity", "utilities"],
  "shortcuts": [
    {
      "name": "Add Habit",
      "short_name": "Add",
      "description": "Quickly create a new habit",
      "url": "/?action=add",
      "icons": [{ "src": "/icon-192x192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    {
      "name": "Today's Habits",
      "short_name": "Today",
      "description": "View habits due today",
      "url": "/?tab=today",
      "icons": [{ "src": "/icon-192x192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    }
  ],
  "icons": [
    { "src": "/icon-192x192.svg", "sizes": "192x192", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-512x512.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-maskable-512.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "maskable" }
  ]
}
