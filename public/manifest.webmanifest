{
  "id": "/app",
  "name": "Daily Spark",
  "short_name": "Daily Spark",
  "description": "A calm, offline-first habit and streak tracker. No login, no ads, no tracking.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#17171D",
  "theme_color": "#17171D",
  "categories": ["productivity", "lifestyle", "health"],
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "/app", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Insights", "url": "/app/insights", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
